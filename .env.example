DISCORD_BOT_TOKEN=
DISCORD_APPLICATION_ID=
# Backward-compatible TVM setup. See examples/shoot-only.env.example for a
# neutral, shoot-only installation and docs/reference/configuration.md for aliases.
# Membership defaults to true; missing mail credentials never disable it implicitly.
MEMBERSHIP_ENABLED=true
TVM_DATABASE_PATH=./config/tvm.db
TVM_GUILD_ID=
TVM_MEMBER_ROLE_ID=
TVM_EXEC_ROLE_ID=
TVM_ADMIN_ROLE_ID=
TVM_PRODUCTION_ACCESS_ROLE_ID=
# Required when shoot workspaces are enabled; assigned and removed manually.
TVM_UNVERIFIED_ROLE_ID=
TVM_ADMIN_ALERT_CHANNEL_ID=
SMTP_FROM=verify@tvm.example.com
RESEND_API_KEY=
VERIFICATION_CODE_SECRET=

# Optional shoot workspaces: set all three IDs to enable, or leave all unset.
TVM_SHOOT_ANNOUNCEMENT_CHANNEL_ID=
TVM_SHOOT_CATEGORY_ID=
TVM_SHOOT_ARCHIVE_CATEGORY_ID=

# Optional deployment overrides; existing TVM wording and Toronto time are defaults.
SHOOT_TIMEZONE=America/Toronto
UI_TEXT_PATH=
# Comma-separated eligible role IDs; defaults to GM, Exec, and Admin when membership is enabled.
SHOOT_ELIGIBLE_ROLE_IDS=
