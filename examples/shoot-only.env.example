# Copy to .env.local, fill the IDs/token, and use a dedicated Discord test server first.
DISCORD_BOT_TOKEN=
DISCORD_APPLICATION_ID=
DISCORD_GUILD_ID=
MEMBERSHIP_ENABLED=false
BOT_ADMIN_ROLE_ID=
ADMIN_ALERT_CHANNEL_ID=
# Explicit Discord role eligibility; no roster or membership roles are required.
# Include the bot-admin role here if those administrators should also be eligible.
SHOOT_ELIGIBLE_ROLE_IDS=
PRODUCTION_ACCESS_ROLE_ID=
SHOOT_ANNOUNCEMENT_CHANNEL_ID=
SHOOT_CATEGORY_ID=
SHOOT_ARCHIVE_CATEGORY_ID=
SHOOT_TIMEZONE=Europe/London
UI_TEXT_PATH=./examples/generic-ui-text.json
# Local runs only. Compose intentionally keeps /usr/app/config/tvm.db on tvm_data.
DATABASE_PATH=./config/tvm.db
